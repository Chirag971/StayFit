    <Grid>
        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#0D47A1"
                              Offset="0.0" />
                <GradientStop Color="#42A5F5"
                              Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Center Content -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="20">

            <!-- Logo -->
            <Image Source="stayfit_logo.png"
                   HeightRequest="400"
                   WidthRequest="400"
                   Aspect="AspectFit" />

            <!-- App Name -->
            <Label Text="StayFit"
                   TextColor="White"
                   FontSize="40"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
