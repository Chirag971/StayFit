<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StayFit.HomePage"
             BackgroundColor="{StaticResource Secondary}"
             Title="StayFit">
    
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Label
        Text="StayFit"
        FontSize="30"
        FontAttributes="Bold"
        TextColor="White"
        HorizontalOptions="Center"
        Margin="0,20"/>

        <!-- Inputs -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Exercises -->
                <Frame BackgroundColor="{StaticResource CardBg}" CornerRadius="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Number of Exercises" TextColor="White"/>
                        <Entry x:Name="txtExercises"
                               Text="3"
                               Keyboard="Numeric"
                               Grid.Column="1" 
                               TextColor="White"/>
                    </Grid>
                </Frame>

                <!-- Sets -->
                <Frame BackgroundColor="{StaticResource CardBg}" CornerRadius="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Number of Sets" TextColor="White"/>
                        <Entry x:Name="txtSets"
                               Text="5" 
                               Keyboard="Numeric"
                               Grid.Column="1"
                               TextColor="White"/>
                    </Grid>
                </Frame>

                <!-- Duration -->
                <Frame BackgroundColor="{StaticResource CardBg}" CornerRadius="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Duration (sec)" TextColor="White"/>
                        <Entry x:Name="txtDuration" Text="10" Keyboard="Numeric"
                       Grid.Column="1" TextColor="White"/>
                    </Grid>
                </Frame>

                <!-- Gap -->
                <Frame BackgroundColor="{StaticResource CardBg}" CornerRadius="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Gap Between Sets" TextColor="White"/>
                        <Entry x:Name="txtGap" Text="3" Keyboard="Numeric"
                       Grid.Column="1" TextColor="White"/>
                    </Grid>
                </Frame>

                <!-- Music -->
                <Button Text="🎵 Select Music"
                BackgroundColor="{StaticResource Primary}"
                CornerRadius="20"
                Clicked="OnSelectMusic"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Start Button -->
        <Button Grid.Row="2"
            Text="START WORKOUT"
            Margin="20"
            HeightRequest="60"
            FontAttributes="Bold"
            BackgroundColor="{StaticResource Accent}"
            CornerRadius="30"
            Clicked="OnStartClicked"/>
    </Grid>

</ContentPage>
