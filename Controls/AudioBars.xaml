    <Frame
        Padding="10"
        BackgroundColor="#0B1E2D"
        CornerRadius="15"
        HasShadow="False">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">

            <!--  AUDIO BARS  -->
            <Grid
                x:Name="BarsGrid"
                Grid.Column="0"
                ColumnDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="5"
                VerticalOptions="End">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Grid.GestureRecognizers>

                <BoxView
                    x:Name="Bar1"
                    Grid.Column="0"
                    HeightRequest="20"
                    WidthRequest="6"
                    Color="#B000B5" />
                <BoxView
                    x:Name="Bar2"
                    Grid.Column="1"
                    HeightRequest="14"
                    WidthRequest="6"
                    Color="#B000B5" />
                <BoxView
                    x:Name="Bar3"
                    Grid.Column="2"
                    HeightRequest="20"
                    WidthRequest="6"
                    Color="#B000B5" />
                <BoxView
                    x:Name="Bar4"
                    Grid.Column="3"
                    HeightRequest="14"
                    WidthRequest="6"
                    Color="#B000B5" />

            </Grid>

            <!--  SLIDER  -->
            <Slider
                x:Name="sliderVolume"
                Grid.Column="1"
                Maximum="1"
                MaximumTrackColor="#FFD580"
                Minimum="0"
                MinimumTrackColor="#9B00FF"
                ThumbColor="#FF8C00"
                ValueChanged="Slider_ValueChanged"
                VerticalOptions="Center"
                WidthRequest="130"
                Value="0.5" />

        </Grid>

    </Frame>

</ContentView>