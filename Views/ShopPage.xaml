<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.ShopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource Secondary}"
    Shell.NavBarIsVisible="True">


    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="25">

            <!--  🔷 Banner  -->
            <Frame
                Padding="15"
                BackgroundColor="#4CAF50"
                CornerRadius="25"
                HasShadow="True">

                <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                    <Image HeightRequest="55" Source="cart.png" />

                    <Label
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        FontSize="16"
                        Text="Explore Wellness Products for a Healthier You!"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!--  🔷 Categories  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Categories"
                TextColor="{StaticResource TextPrimary}" />
            <CollectionView
                HeightRequest="110"
                ItemsLayout="HorizontalList"
                ItemsSource="{Binding Categories}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="5"
                            Padding="10"
                            BackgroundColor="White"
                            CornerRadius="15">

                            <VerticalStackLayout HorizontalOptions="Center">

                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterCommand}" CommandParameter="{Binding Name}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Image HeightRequest="60" Source="{Binding IconPath}" />

                                <Label
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding Name}"
                                    TextColor="Black" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!--  🔷 Top Supplements  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Top Supplements"
                TextColor="{StaticResource TextPrimary}" />

            <CollectionView ItemsSource="{Binding FeaturedItems}">

                <!--  🔥 THIS IS THE MAIN FIX  -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="10"
                        Orientation="Vertical"
                        Span="2"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="5"
                            Padding="10"
                            BackgroundColor="White"
                            CornerRadius="18"
                            HasShadow="True">

                            <VerticalStackLayout Spacing="6">

                                <!--  Image  -->
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="110"
                                    Source="{Binding ImageSource}" />

                                <!--  Brand  -->
                                <Label
                                    FontSize="11"
                                    Text="{Binding BrandName}"
                                    TextColor="{StaticResource TextPrimary}" />

                                <!--  Title  -->
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextColor="#222" />


                                <Label
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding ShortDescription}"
                                    TextColor="{StaticResource Secondary}" />
                                <!--  Price + Button  -->
                                <Grid ColumnDefinitions="*,Auto">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="17"
                                        Text="{Binding PriceText}"
                                        TextColor="#4CAF50" />

                                    <Button
                                        BackgroundColor="{StaticResource Primary}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddItemCommand}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="End"
                                        Text="Add To Cart"
                                        WidthRequest="110" />

                                </Grid>

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  🔷 Fitness Gear  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Fitness Gear"
                TextColor="{StaticResource TextPrimary}" />

            <CollectionView ItemsSource="{Binding FilteredItems}">

                <!--  🔥 MAIN FIX (2 COLUMN)  -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="10"
                        Orientation="Vertical"
                        Span="2"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="5"
                            Padding="10"
                            BackgroundColor="White"
                            CornerRadius="18"
                            HasShadow="True">

                            <VerticalStackLayout Spacing="6">

                                <!--  Image  -->
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="110"
                                    Source="{Binding ImageSource}"
                                    WidthRequest="400" />

                                <!--  Title  -->
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextColor="#222" />
                                <Label
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding ShortDescription}"
                                    TextColor="{StaticResource Secondary}" />


                                <!--  Price  -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="17"
                                        Text="{Binding PriceText}"
                                        TextColor="#4CAF50" />

                                    <Button
                                        BackgroundColor="{StaticResource Primary}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddItemCommand}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="End"
                                        Text="Add To Cart"
                                        WidthRequest="110" />
                                </Grid>
                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>