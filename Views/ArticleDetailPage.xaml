<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.ArticleDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StayFitz.ViewModels"
    BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Image
                Aspect="AspectFill"
                HeightRequest="250"
                Source="{Binding Article.Image}" />

            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="{Binding Article.Title}" />

            <Label FontSize="16" Text="{Binding Article.Description}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>