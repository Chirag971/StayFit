<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.ArticleDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StayFitz.ViewModels"
    BackgroundColor="{StaticResource Secondary}">

    <ScrollView>

        <VerticalStackLayout Spacing="15">

            <!--  🔥 RESPONSIVE IMAGE  -->
            <Grid>
                <Grid.HeightRequest>
                    <OnIdiom
                        x:TypeArguments="x:Double"
                        Desktop="320"
                        Phone="220"
                        Tablet="260" />
                </Grid.HeightRequest>

                <Image
                    Margin="10"
                    Aspect="AspectFit"
                    HorizontalOptions="Fill"
                    Source="{Binding Article.Image}"
                    VerticalOptions="Fill" />
            </Grid>


            <VerticalStackLayout Padding="15" Spacing="10">


                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    Text="{Binding Article.Title}"
                    TextColor="{StaticResource TextPrimary}" />

                <BoxView
                    HeightRequest="1"
                    Opacity="0.3"
                    Color="{StaticResource TextSecondary}" />


                <Label
                    FontSize="16"
                    LineHeight="1.4"
                    Text="{Binding Article.Description}"
                    TextColor="{StaticResource TextSecondary}" />

                <Button
                    Margin="25"
                    BackgroundColor="{StaticResource CardBg}"
                    Command="{Binding ShareCommand}"
                    CornerRadius="12"
                    HeightRequest="50"
                    ImageSource="share.png"
                    Text=" Share Article"
                    TextColor="White"
                    WidthRequest="153" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>