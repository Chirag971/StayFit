<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.ShopDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ProductDetailPage">
    <ScrollView>

        <Grid RowDefinitions="Auto,*">

            <!--  🔷 Product Image Section  -->
            <Frame
                Margin="10"
                Padding="40"
                BackgroundColor="#2A2A2A"
                CornerRadius="20"
                HasShadow="True">

                <Image
                    Aspect="AspectFit"
                    HeightRequest="220"
                    HorizontalOptions="Center"
                    Source="{Binding ImageSource}" />
            </Frame>

            <!--  🔷 Details Section  -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="15" Spacing="12">

                    <!--  Title  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding Title}"
                        TextColor="White" />

                    <!--  Brand  -->
                    <Label
                        FontSize="14"
                        Text="{Binding BrandName}"
                        TextColor="#AAAAAA" />

                    <!--  Divider  -->
                    <BoxView HeightRequest="1" Color="#333" />

                    <!--  Product Details  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Product Details"
                        TextColor="White" />

                    <Label
                        FontSize="14"
                        LineBreakMode="WordWrap"
                        Text="{Binding FullDescription}"
                        TextColor="#CCCCCC" />

                    <!--  Price  -->
                    <Label
                        Margin="0,10,0,0"
                        FontAttributes="Bold"
                        FontSize="26"
                        Text="{Binding PriceText}"
                        TextColor="#00C853" />

                    <!--  🔷 Quantity Section  -->
                    <Frame
                        Padding="10"
                        BackgroundColor="#2A2A2A"
                        CornerRadius="15"
                        HorizontalOptions="Center"
                        WidthRequest="180">

                        <Grid ColumnDefinitions="*,Auto,*" VerticalOptions="Center">

                            <!--  Minus  -->
                            <Button
                                Grid.Column="0"
                                BackgroundColor="#444"
                                Command="{Binding DecreaseCommand}"
                                CornerRadius="20"
                                FontSize="30"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                Text="-"
                                TextColor="White"
                                VerticalOptions="Center"
                                WidthRequest="40" />

                            <!--  Quantity  -->
                            <Label
                                Grid.Column="1"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding Quantity}"
                                TextColor="White"
                                VerticalOptions="Center" />

                            <!--  Plus  -->
                            <Button
                                Grid.Column="2"
                                BackgroundColor="#444"
                                Command="{Binding IncreaseCommand}"
                                CornerRadius="20"
                                FontSize="30"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                Text="+"
                                TextColor="White"
                                VerticalOptions="Center"
                                WidthRequest="40" />

                        </Grid>
                    </Frame>

                    <!--  🔷 Buy Button  -->
                    <Button
                        Margin="0,20,0,20"
                        BackgroundColor="#FF6F00"
                        Command="{Binding AddToCartCommand}"
                        CornerRadius="25"
                        FontSize="18"
                        HeightRequest="55"
                        Text="Buy Now"
                        TextColor="White" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ScrollView>
</ContentPage>