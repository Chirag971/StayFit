<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.WishlistPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="WishlistPage">

    <CollectionView ItemsSource="{Binding WishlistItems}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame
                    Margin="10"
                    Padding="10"
                    CornerRadius="15">
                    <HorizontalStackLayout Spacing="10">

                        <Image Source="{Binding ImageSource}" WidthRequest="80" />

                        <VerticalStackLayout>
                            <Label FontAttributes="Bold" Text="{Binding Title}" />
                            <Label Text="{Binding PriceText}" TextColor="Green" />
                        </VerticalStackLayout>

                    </HorizontalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>