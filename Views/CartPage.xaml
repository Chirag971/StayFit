<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ScrollView>

        <VerticalStackLayout>

            <!--  🔥 TOP TITLE  -->
            <Label
                Margin="20,15,0,5"
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="Shopping Cart"
                TextColor="White" />

            <!--  🛒 CART ITEMS  -->
            <CollectionView Margin="0,10" ItemsSource="{Binding CartItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="15,10"
                            Padding="14"
                            BackgroundColor="#2A2A2A"
                            CornerRadius="15">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!--  Image  -->
                                <Image
                                    HeightRequest="70"
                                    Source="{Binding ImageSource}"
                                    WidthRequest="70" />

                                <!--  Details  -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding Title}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="12"
                                        Text="{Binding BrandName}"
                                        TextColor="#AAAAAA" />

                                    <!--  Quantity  -->
                                    <Label
                                        FontSize="13"
                                        Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                        TextColor="#CCCCCC" />

                                    <!--  Price  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding TotalPriceText}"
                                        TextColor="#00C853" />

                                </VerticalStackLayout>

                                <!--  Delete  -->
                                <ImageButton
                                    Grid.Column="2"
                                    Margin="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="10"
                                    HeightRequest="30"
                                    Source="delete.png"
                                    WidthRequest="30" />

                            </Grid>
                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <!--  🔥 TOTAL PRICE  -->
            <Frame
                Margin="10"
                Padding="12"
                BackgroundColor="#2A2A2A"
                CornerRadius="12">

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Total Price :"
                        TextColor="White" />

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="End"
                        Text="{Binding GrandTotalText}"
                        TextColor="#00C853" />

                </Grid>

            </Frame>


            <!--  🔥 PROCESS BUTTON  -->
            <Button
                Margin="20,10"
                BackgroundColor="{StaticResource Primary}"
                Command="{Binding CheckoutCommand}"
                CornerRadius="25"
                FontSize="18"
                HeightRequest="55"
                Text="Proceed to Buy"
                TextColor="White"
                WidthRequest="180" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>