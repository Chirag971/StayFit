        <!--  Articles  -->
        <CollectionView
            Grid.Row="2"
            Margin="10"
            ItemsSource="{Binding Articles}">

            <!--  🔥 Responsive Layout  -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="15"
                    Orientation="Vertical"
                    VerticalItemSpacing="15">
                    <GridItemsLayout.Span>
                        <OnIdiom
                            x:TypeArguments="x:Int32"
                            Desktop="3"
                            Phone="1"
                            Tablet="2" />
                    </GridItemsLayout.Span>
                </GridItemsLayout>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Margin="10"
                        Padding="0"
                        CornerRadius="20"
                        HasShadow="True"
                        HorizontalOptions="Fill">

                        <Grid HeightRequest="350">

                            <!--  📸 Image  -->
                            <Image Aspect="AspectFill" Source="{Binding Image}" />

                            <!--  🌑 Gradient Overlay  -->
                            <BoxView>
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.5" Color="Transparent" />
                                        <GradientStop Offset="1.0" Color="#CC000000" />
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>

                            <!--  📝 Text  -->
                            <VerticalStackLayout
                                Padding="15"
                                Spacing="5"
                                VerticalOptions="End">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding Title}"
                                    TextColor="White" />

                                <Label
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Description}"
                                    TextColor="LightGray" />

                            </VerticalStackLayout>

                        </Grid>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ArticleCommand}" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>