            Grid.Row="0"
            Margin="15,10"
            BackgroundColor="White"
            Placeholder="Search health topics..."
            PlaceholderColor="Gray"
            Text="{Binding SearchText}"
            TextColor="Black" />

        <!--  Categories  -->
