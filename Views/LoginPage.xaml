<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StayFitz.ViewModels"
    BackgroundColor="{StaticResource Secondary}"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!--  LOGIN UI  -->
        <ScrollView>

            <Grid Padding="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!--  LOGO  -->
                <Image
                    Grid.Row="0"
                    Margin="0,30,0,50"
                    Aspect="AspectFit"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    Source="stayfitz.png"
                    WidthRequest="120" />


                <!--  TITLE  -->
                <!--<Label
                    Grid.Row="1"
                    Margin="0,0,0,30"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="StayFitz"
                    TextColor="White" />-->


                <!--  PIN  -->
                <Frame
                    Grid.Row="2"
                    Margin="0,0,0,15"
                    Padding="10"
                    BackgroundColor="White"
                    CornerRadius="12"
                    HasShadow="False">

                    <Entry
                        x:Name="PinEntry"
                        Keyboard="Text"
                        MaxLength="8"
                        Placeholder="UserName"
                        PlaceholderColor="Gray"
                        Text="{Binding Pin}"
                        TextChanged="PinEntry_TextChanged"
                        TextColor="Black" />
                </Frame>

                <Frame
                    Grid.Row="3"
                    Margin="0,0,0,25"
                    Padding="10"
                    BackgroundColor="White"
                    CornerRadius="12"
                    HasShadow="False">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Enter a Password" />
                        <Entry
                            x:Name="PasswordEntry"
                            Grid.Column="0"
                            IsPassword="True"
                            MaxLength="8"
                            Placeholder="Enter Password"
                            PlaceholderColor="Gray"
                            Text="{Binding Password}"
                            TextChanged="PasswordEntry_TextChanged"
                            TextColor="Black" />

                        <ImageButton
                            x:Name="EyeButton"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            Clicked="EyeButton_Clicked"
                            HeightRequest="28"
                            Source="eye.png"
                            WidthRequest="28" />

                    </Grid>
                </Frame>


                <!--  LOGIN BUTTON  -->
                <Button
                    Grid.Row="4"
                    Margin="0,0,0,20"
                    BackgroundColor="White"
                    Command="{Binding LoginCommand}"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Text="Login"
                    TextColor="Black" />


                <!--  SSO LOGIN  -->
                <Label
                    Grid.Row="5"
                    Margin="0,0,0,20"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Text="Click here to login via SSO"
                    TextColor="#2E7DFF">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SSOLoginCommand}" />
                    </Label.GestureRecognizers>

                </Label>


                <!--  SKIP BUTTON  -->
                <Button
                    Grid.Row="6"
                    BackgroundColor="White"
                    Command="{Binding BackCommand}"
                    CornerRadius="12"
                    HeightRequest="45"
                    HorizontalOptions="Center"
                    Text="Skip"
                    TextColor="Black"
                    WidthRequest="140" />

            </Grid>

        </ScrollView>


        <!--  LOADER OVERLAY  -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsLoading}">

            <ActivityIndicator
                HeightRequest="50"
                HorizontalOptions="Center"
                IsRunning="{Binding IsLoading}"
                VerticalOptions="Center"
                WidthRequest="50"
                Color="Red" />

        </Grid>

    </Grid>

</ContentPage>