<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CategoryPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!--  Category Title  -->
            <Label
                FontAttributes="Bold"
                FontSize="28"
                Text="{Binding CategoryName}"
                TextColor="#4CAF50" />

            <!--  Articles  -->
            <CollectionView ItemsSource="{Binding Articles}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="0,10"
                            Padding="15"
                            CornerRadius="20"
                            HasShadow="True">

                            <VerticalStackLayout Spacing="10">

                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="200"
                                    HorizontalOptions="FillAndExpand"
                                    Source="{Binding Image}" />

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding Title}" />

                                <Label
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Description}" />

                            </VerticalStackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenArticleCommand}" CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>