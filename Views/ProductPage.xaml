                ImageSource="logout.png"
                TextColor="Black" />-->

        </Grid>
        <CollectionView
            Grid.Row="1"
            Margin="10,5"
            ItemsSource="{Binding Options}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="10"
                    Orientation="Vertical"
                    Span="{OnIdiom Phone=1,
                                   Tablet=2,
                                   Desktop=2}"
                    VerticalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Padding="0"
                        BackgroundColor="{Binding Color}"
                        CornerRadius="25"
                        HasShadow="True"
                        HeightRequest="{OnIdiom Phone=140,
                                                Tablet=180,
                                                Desktop=190}">

                        <Grid>

                            <!--  Tap Gesture  -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OptionSelectedCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <!--  Content  -->
                            <VerticalStackLayout
                                Padding="15"
                                HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">

                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="90"
                                    Source="{Binding Image}"
                                    WidthRequest="90" />

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding Title}"
                                    TextColor="White" />

                            </VerticalStackLayout>

                        </Grid>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--<Frame
            Grid.Row="2"
            Margin="{OnIdiom Phone=0,
