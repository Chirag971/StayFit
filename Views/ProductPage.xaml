        <Grid
            Grid.Row="0"
            Margin="0,0,0,10"
            ColumnDefinitions="*,Auto,Auto">

            <!--<Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Products"
                TextColor="White"
                VerticalOptions="Center" />-->

            <!--  LOGOUT BUTTON  -->
            <!--<Button
                Grid.Column="2"
