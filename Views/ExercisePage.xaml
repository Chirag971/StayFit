<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.ExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uc="clr-namespace:StayFitz.Controls"
    xmlns:vm="clr-namespace:StayFitz.ViewModels"
    x:Name="ThisPage"
    BackgroundColor="{StaticResource Secondary}">


    <ScrollView>
        <Grid>

            <!--  Background  -->
            <BoxView BackgroundColor="#66000000" />
            <!--  lighter overlay  -->


            <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*,Auto">

                <!--  HEADER  -->
                <VerticalStackLayout
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        x:Name="lblExerciseCount"
                        FontSize="18"
                        TextColor="White" />

                    <Label
                        x:Name="lblSetCount"
                        FontSize="16"
                        TextColor="White" />

                </VerticalStackLayout>


                <!--  TIMER  -->
                <Grid
                    Grid.Row="1"
                    Margin="0,25"
                    HeightRequest="220"
                    HorizontalOptions="Center"
                    WidthRequest="220">

                    <GraphicsView
                        x:Name="circularRing"
                        HeightRequest="220"
                        WidthRequest="220" />

                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">

                        <Label
                            x:Name="lblTimer"
                            FontSize="60"
                            HorizontalOptions="Center"
                            TextColor="White" />

                        <Label
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="SECONDS"
                            TextColor="White" />

                        <Label
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="♪"
                            TextColor="White" />

                    </VerticalStackLayout>

                </Grid>


                <!--  MODE SWITCH  -->
                <!--<HorizontalStackLayout
                Grid.Row="2"
                Margin="0,10"
                HorizontalOptions="Center"
                Spacing="10">

                <Label
                    Text="Exercise Wise"
                    TextColor="White"
                    VerticalOptions="Center" />

                <Switch x:Name="modeSwitch" Toggled="OnModeToggled" />

                <Label
                    Text="Set Wise"
                    TextColor="White"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>-->
                <Frame
                    Grid.Row="2"
                    Margin="20,10"
                    Padding="12"
                    BackgroundColor="#1E1E1E"
                    CornerRadius="25"
                    HasShadow="True">

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

                        <!--  Mode Label  -->
                        <Label
                            x:Name="lblMode"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Exercise Wise Sets"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <!--  Switch  -->
                        <Switch
                            x:Name="modeSwitch"
                            Grid.Column="1"
                            HorizontalOptions="End"
                            OnColor="#4CAF50"
                            ThumbColor="White"
                            Toggled="OnModeToggled"
                            VerticalOptions="Center" />

                    </Grid>

                </Frame>
                <!--  EXERCISE LIST  -->
                <!--<CollectionView
                Grid.Row="3"
                Margin="0,10"
                ItemsSource="{Binding Source={x:Reference ThisPage}, Path=ExerciseList}"
                SelectionMode="None"
                VerticalOptions="FillAndExpand">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="0,5"
                            Padding="15"
                            BackgroundColor="#2E2E2E"
                            CornerRadius="18">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto">

                                <Image
                                    HeightRequest="40"
                                    Source="{Binding Icon}"
                                    WidthRequest="40" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="16"
                                    Text="{Binding Name}"
                                    TextColor="White" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="14"
                                    Text="{Binding Status}"
                                    TextColor="{Binding StatusColor}" />

                                <uc:LinearProgressBar
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Margin="0,8,0,0"
                                    HeightRequest="6"
                                    Progress="{Binding Progress}"
                                    ProgressColor="{Binding ProgressColor}" />

                            </Grid>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>-->
                <CollectionView
                    Grid.Row="3"
                    Margin="0,10"
                    HeightRequest="220"
                    ItemsSource="{Binding Source={x:Reference ThisPage}, Path=ExerciseList}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Frame
                                Margin="0,6"
                                Padding="12"
                                BackgroundColor="#2E2E2E"
                                CornerRadius="16"
                                HasShadow="False">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto">

                                    <!--  Exercise Name  -->
                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="{Binding Name}"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <!--  Status  -->
                                    <Label
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="{Binding Status}"
                                        TextColor="{Binding StatusColor}"
                                        VerticalOptions="Center" />

                                    <!--  Progress  -->
                                    <uc:LinearProgressBar
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,6,0,0"
                                        HeightRequest="5"
                                        Progress="{Binding Progress}"
                                        ProgressColor="{Binding ProgressColor}" />

                                </Grid>

                            </Frame>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>


                <!--  BOTTOM CONTROLS  -->
                <VerticalStackLayout
                    Grid.Row="4"
                    Margin="0,10"
                    Spacing="10"
                    VerticalOptions="End">

                    <ProgressBar
                        x:Name="progressBar"
                        HeightRequest="8"
                        Progress="0" />

                    <Label
                        x:Name="lblRestTimer"
                        HorizontalOptions="Center"
                        TextColor="White" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                        <Button
                            x:Name="btnStart"
                            Grid.Column="0"
                            BackgroundColor="Green"
                            Clicked="OnStartClicked"
                            Text="Start"
                            TextColor="White" />

                        <Button
                            x:Name="btnPause"
                            Grid.Column="1"
                            BackgroundColor="Orange"
                            Clicked="OnPauseClicked"
                            Text="Pause"
                            TextColor="White" />

                        <Button
                            Grid.Column="2"
                            BackgroundColor="Gray"
                            Clicked="OnResetClicked"
                            Text="Reset"
                            TextColor="White" />

                    </Grid>

                    <!--<uc:AudioBars x:Name="audioBar" HorizontalOptions="FillAndExpand" />-->
                    <uc:AudioBars x:Name="audioBar" HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>


