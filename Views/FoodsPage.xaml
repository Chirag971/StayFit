<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.FoodsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="FoodsPage">

    <CollectionView Margin="10" ItemsSource="{Binding Foods}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="0,25,0,0" Padding="10">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnItemTapped"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="80,*,Auto">

                        <Image HeightRequest="60" Source="{Binding Image}" />

                        <VerticalStackLayout Grid.Column="1" Margin="10">
                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                            <Label FontSize="12" Text="{Binding Calories}" />
                            <Label
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Description}"
                                TextColor="LightGray" />
                        </VerticalStackLayout>

                        <!--<Button
                            Grid.Column="2"
                            Clicked="OnViewClicked"
                            Text="View" />-->
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>