<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.FitnessGoalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="FitnessGoalPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!--  HEADER  -->
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="Your Goals"
                TextColor="White" />

            <!--  GOALS LIST  -->
            <CollectionView ItemsSource="{Binding Goals}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="0,5"
                            Padding="15"
                            BackgroundColor="#1C1C1E"
                            CornerRadius="20">

                            <VerticalStackLayout Spacing="10">


                                <Grid ColumnDefinitions="Auto,*,Auto">

                                    <Image
                                        HeightRequest="40"
                                        Source="{Binding Icon}"
                                        WidthRequest="40" />

                                    <Label
                                        Grid.Column="1"
                                        Margin="10,0"
                                        FontSize="16"
                                        Text="{Binding Title}"
                                        TextColor="{StaticResource TextPrimary}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="2"
                                        FontSize="12"
                                        Text="{Binding Display}"
                                        TextColor="#AAAAAA"
                                        VerticalOptions="Center" />
                                </Grid>


                                <ProgressBar
                                    BackgroundColor="#2A2A2D"
                                    HeightRequest="8"
                                    Progress="{Binding Progress}"
                                    ProgressColor="{StaticResource Primary}" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!--  BUTTON  -->
            <!--<Button
                BackgroundColor="#FF7A00"
                CornerRadius="30"
                FontAttributes="Bold"
                HeightRequest="55"
                Text="Set Goals"
                TextColor="White" />-->


            <Button
                BackgroundColor="#FF7A00"
                Clicked="OnSetGoalClicked"
                CornerRadius="30"
                FontAttributes="Bold"
                HeightRequest="55"
                Text="Set Goals" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>