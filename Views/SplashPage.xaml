    <Grid>

        <!--  Gradient Background  -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#6EB6FF" />
                <GradientStop Offset="0.5" Color="#6ED4C5" />
                <GradientStop Offset="1.0" Color="#9BE37F" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--  Center Content  -->
        <VerticalStackLayout
            HorizontalOptions="Center"
            Spacing="20"
            VerticalOptions="Center">

            <!--  Logo  -->
            <Image
                Aspect="AspectFit"
                HeightRequest="120"
                Source="stayfitz.png"
                WidthRequest="120" />

            <!--  App Name  -->
            <Label
                FontAttributes="Bold"
                FontSize="36"
                HorizontalOptions="Center"
                IsVisible="False"
                Text="StayFitz"
                TextColor="#2C2C2C" />

        </VerticalStackLayout>

    </Grid>

