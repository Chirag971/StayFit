<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            <Frame
                Padding="20"
                BackgroundColor="{StaticResource CardBg}"
                CornerRadius="25"
                HasShadow="True">

                <HorizontalStackLayout Spacing="15">

                    <!--  Circular Image  -->
                    <Frame
                        Padding="0"
                        CornerRadius="40"
                        HeightRequest="80"
                        IsClippedToBounds="True"
                        WidthRequest="80">

                        <Image Aspect="AspectFill" Source="{Binding ProfileImage}" />
                    </Frame>
                    <!--  User Info  -->
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{Binding UserName}"
                            TextColor="Black" />

                        <Label
                            FontSize="13"
                            Text="{Binding Email}"
                            TextColor="Gray" />
                        <Frame
                            Padding="6,2"
                            BackgroundColor="#66BB6A"
                            CornerRadius="12"
                            HorizontalOptions="Start"
                            IsVisible="{Binding IsPremium}">
                            <Label
                                FontSize="11"
                                Text="★ Premium Member"
                                TextColor="White" />
                        </Frame>
                    </VerticalStackLayout>
                    <Button
                        BackgroundColor="#E0E0E0"
                        Command="{Binding EditProfileCommand}"
                        CornerRadius="15"
                        HeightRequest="35"
                        HorizontalOptions="EndAndExpand"
                        Text="Edit"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Frame>
            <CollectionView ItemsSource="{Binding Stats}" SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="10"
                        Orientation="Vertical"
                        Span="2"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="15"
                            BackgroundColor="{StaticResource CardBg}"
                            CornerRadius="20"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="6">

                                <Image
                                    HeightRequest="80"
                                    Source="{Binding Icon}"
                                    WidthRequest="80" />

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding Value}"
                                    TextColor="White" />

                                <Label
                                    FontSize="13"
                                    Text="{Binding Title}"
                                    TextColor="Gray" />

                            </VerticalStackLayout>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <CollectionView ItemsSource="{Binding Settings}" SelectionMode="None">

                <!--  new code for spancing  -->

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="1" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="50"
                            BackgroundColor="{StaticResource CardBg}"
                            CornerRadius="15"
                            HasShadow="False">

                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                                <Image
                                    Grid.Column="0"
                                    HeightRequest="25"
                                    Source="{Binding Icon}"
                                    WidthRequest="25" />

                                <Label
                                    Grid.Column="1"
                                    Margin="10,0"
                                    FontSize="15"
                                    Text="{Binding Title}"
                                    TextColor="White"
                                    VerticalOptions="Center" />

                                <!--  Arrow  -->
                                <Label
                                    Grid.Column="2"
                                    FontSize="16"
                                    Text="&gt;"
                                    TextColor="White"
                                    VerticalTextAlignment="End" />

                            </Grid>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
            <Button
                BackgroundColor="{StaticResource Primary}"
                Command="{Binding ViewProgressCommand}"
                CornerRadius="30"
                FontAttributes="Bold"
                HeightRequest="55"
                Text="View Progress"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>