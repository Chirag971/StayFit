<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">


            <Frame
                Padding="15"
                BackgroundColor="#1C1C1E"
                CornerRadius="25"
                HasShadow="False">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                    <!--  Profile Image  -->
                    <Frame
                        Padding="0"
                        BackgroundColor="#2A2A2D"
                        CornerRadius="35"
                        HeightRequest="70"
                        IsClippedToBounds="True"
                        WidthRequest="70">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UploadImageCommand}" />
                        </Frame.GestureRecognizers>

                        <Image
                            Aspect="AspectFill"
                            HeightRequest="55"
                            Source="{Binding ProfileImage}"
                            WidthRequest="50" />
                    </Frame>


                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="10,0"
                        Spacing="3">

                        <!--<Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding UserName}"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            FontSize="12"
                            Text="{Binding Email}"
                            TextColor="{StaticResource TextPrimary}" />-->

                        <Label FontSize="18" Text="{Binding UserName}" />
                        <Label FontSize="18" Text="{Binding Email}" />

                        <Frame
                            Padding="6,2"
                            BackgroundColor="#34C759"
                            CornerRadius="10"
                            HorizontalOptions="Start"
                            IsVisible="{Binding IsPremium}">

                            <Label
                                FontSize="10"
                                Text="★ Premium Member"
                                TextColor="{StaticResource TextPrimary}" />
                        </Frame>
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#2C2C2E"
                        Command="{Binding EditProfileCommand}"
                        CornerRadius="15"
                        FontSize="12"
                        HeightRequest="35"
                        Text="Edit"
                        TextColor="White" />

                </Grid>
            </Frame>

            <CollectionView ItemsSource="{Binding Stats}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="15"
                        Orientation="Vertical"
                        Span="2"
                        VerticalItemSpacing="15" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="15"
                            BackgroundColor="#1C1C1E"
                            CornerRadius="20">

                            <VerticalStackLayout Spacing="10">

                                <Image
                                    HeightRequest="50"
                                    Source="{Binding Icon}"
                                    WidthRequest="50" />

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding Value}"
                                    TextColor="White" />

                                <Label
                                    FontSize="12"
                                    Text="{Binding Title}"
                                    TextColor="#AAAAAA" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  SETTINGS LIST  -->
            <CollectionView ItemsSource="{Binding Settings}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="25"
                            Padding="15"
                            BackgroundColor="#1C1C1E"
                            CornerRadius="15">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateCommand}" CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Image
                                    HeightRequest="22"
                                    Source="{Binding Icon}"
                                    WidthRequest="22" />

                                <Label
                                    Grid.Column="1"
                                    Margin="10,0"
                                    FontSize="14"
                                    Text="{Binding Title}"
                                    TextColor="White" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="18"
                                    Text="›"
                                    TextColor="#888" />
                            </Grid>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  BUTTON  -->
            <!--<Button
                BackgroundColor="{StaticResource Primary}"
                CornerRadius="30"
                FontAttributes="Bold"
                HeightRequest="55"
                Text="View Progress"
                TextColor="White" />-->

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>