<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.DietPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StayFitz.ViewModels"
    BackgroundColor="{StaticResource Secondary}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!--  Greeting  -->
            <Frame
                Padding="15"
                BackgroundColor="LightGreen"
                CornerRadius="20">
                <VerticalStackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="Diet" />
                    <Label FontSize="16" Text="{Binding Greeting}" />
                </VerticalStackLayout>
            </Frame>

            <!--  Calories Section  -->
            <Frame
                Padding="15"
                BackgroundColor="{StaticResource CardBg}"
                CornerRadius="20">

                <VerticalStackLayout Spacing="10">
                    <Label FontSize="16" Text="Daily Calories" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="{Binding DailyCalories}"
                        TextColor="White" />

                    <ProgressBar
                        BackgroundColor="#E0E0E0"
                        HeightRequest="10"
                        Progress="{Binding Progress}"
                        ProgressColor="Green" />
                </VerticalStackLayout>
            </Frame>

            <!--  Buttons  -->
            <HorizontalStackLayout Spacing="15">

                <Button
                    BackgroundColor="#A8E6CF"
                    Command="{Binding AddMealCommand}"
                    CornerRadius="15"
                    Text="Add Meal" />

                <Button
                    BackgroundColor="#DCEFFF"
                    CornerRadius="15"
                    Text="Foods" />

                <Button
                    BackgroundColor="#F8D7FF"
                    CornerRadius="15"
                    Text="Recipes" />
            </HorizontalStackLayout>

            <!--  Healthy Diet Tips  -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Healthy Diet Tips" />

            <CollectionView ItemsLayout="HorizontalList" ItemsSource="{Binding DietTips}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="20"
                            Padding="0"
                            CornerRadius="15"
                            WidthRequest="180">

                            <VerticalStackLayout>
                                <Image
                                    Aspect="AspectFill"
                                    BackgroundColor="White"
                                    HeightRequest="90"
                                    Source="{Binding Image}" />

                                <Label
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    FontAttributes="Bold"
                                    Text="{Binding Title}" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Today's Meals  -->
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Today's Meals" />

            <CollectionView ItemsSource="{Binding TodayMeals}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="5"
                            Padding="10"
                            CornerRadius="15">

                            <Grid ColumnDefinitions="80,*,Auto">

                                <Image
                                    HeightRequest="60"
                                    Source="{Binding Image}"
                                    WidthRequest="60" />

                                <VerticalStackLayout Grid.Column="1">
                                    <Label FontAttributes="Bold" Text="{Binding MealType}" />
                                    <Label Text="{Binding Time}" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Calories}"
                                    VerticalOptions="Center" />
                            </Grid>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>