<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayFitz.Views.DietPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="RootPage"
    BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <!--  🔷 Header  -->
            <VerticalStackLayout Spacing="5">
                <Label
                    FontSize="18"
                    HorizontalOptions="Start"
                    Text=" StayFitz Hello 👋"
                    TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>


            <!--  🔷 Buttons  -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15" />


            <Frame
                Padding="15"
                BackgroundColor="#1E1E1E"
                CornerRadius="15">

                <VerticalStackLayout Spacing="10">
                    <Picker
                        Title="Select Meal Type"
                        ItemsSource="{Binding MealTypes}"
                        SelectedItem="{Binding SelectedMealType}" />

                    <!--  Food Picker (FILTERED)  -->
                    <!--<Picker
                        Title="Select Food"
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding FilteredFoods}"
                        SelectedItem="{Binding SelectedFood}" />-->

                    <Picker
                        Title="Select Food"
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding FilteredFoods}"
                        SelectedItem="{Binding SelectedFood, Mode=TwoWay}" />

                    <Button
                        Grid.Column="0"
                        Margin="0,25,0,0"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding AddMealCommand}"
                        CornerRadius="10"
                        Text="Add Meal"
                        TextColor="White"
                        WidthRequest="100" />
                </VerticalStackLayout>
            </Frame>

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Today's Meals"
                TextColor="White" />

            <CollectionView
                ItemsSource="{Binding TodayMeals}"
                SelectionChanged="OnMealSelected"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="10"
                            Padding="10"
                            BackgroundColor="{StaticResource DarkBackground}"
                            CornerRadius="15">

                            <Grid ColumnDefinitions="70,*,Auto,Auto" ColumnSpacing="10">


                                <Image
                                    HeightRequest="50"
                                    Source="{Binding Image}"
                                    WidthRequest="60" />

                                <VerticalStackLayout Grid.Column="1">
                                    <Label
                                        FontSize="18"
                                        Text="{Binding MealType}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="12"
                                        Text="{Binding Time}"
                                        TextColor="Gray" />
                                </VerticalStackLayout>


                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Margin="10"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding Calories}"
                                        TextColor="#4CAF50" />

                                    <Label
                                        FontSize="12"
                                        Text="Calories"
                                        TextColor="{StaticResource TextPrimary}" />
                                </VerticalStackLayout>

                                <ImageButton
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteMealCommand}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="25"
                                    Source="delete.png"
                                    WidthRequest="25" />

                                <!--<Label
                                    FontAttributes="Bold"
                                    FontSize="25"
                                    Text="{Binding DailyCalories, StringFormat='Total Calories: {0} kcal'}"
                                    TextColor="{StaticResource Primary}" />-->
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>